# ============================================================
# Environment Variables — Example File
# Copy to .env and fill in real values. NEVER commit .env to git!
# ============================================================

# Application
NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0

# Docker Hub (Lab 2 & Lab 4)
DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=your-dockerhub-token

# GitHub (used in Jenkins & GitHub Actions secrets)
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPO=https://github.com/your-username/devops-assignment

# Grafana (Lab 3)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-in-production

# HashiCorp Vault (Lab 4)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root

# Application secrets (store in Vault — not here!)
API_KEY=replace-with-vault-managed-secret
DB_PASSWORD=replace-with-vault-managed-secret
JWT_SECRET=replace-with-vault-managed-secret
