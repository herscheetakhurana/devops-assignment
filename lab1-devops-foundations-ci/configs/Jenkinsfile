pipeline {
    agent any

    environment {
        APP_NAME     = "devops-sample-app"
        APP_VERSION  = "1.0.${BUILD_NUMBER}"
        NODE_ENV     = "production"
        DEPLOY_DIR   = "/var/www/${APP_NAME}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: "10"))
        timeout(time: 20, unit: "MINUTES")
        timestamps()
    }

    stages {
        stage("Checkout") {
            steps {
                echo "--- Checking out source code ---"
                checkout scm
                sh "git log --oneline -5"
            }
        }

        stage("Install Dependencies") {
            steps {
                dir("app") {
                    echo "--- Installing Node.js dependencies ---"
                    sh "npm ci --prefer-offline"
                }
            }
        }

        stage("Run Tests") {
            steps {
                dir("app") {
                    echo "--- Running unit tests ---"
                    sh "npm test -- --ci --reporters=default --reporters=jest-junit"
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "app/junit.xml"
                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: "app/coverage/lcov-report",
                        reportFiles: "index.html",
                        reportName: "Coverage Report"
                    ])
                }
            }
        }

        stage("Build") {
            steps {
                dir("app") {
                    echo "--- Creating build artifact ---"
                    sh """
                        mkdir -p ../build
                        tar -czf ../build/${APP_NAME}-${APP_VERSION}.tar.gz \
                            --exclude=node_modules \
                            --exclude=coverage \
                            .
                    """
                    echo "Build artifact: build/${APP_NAME}-${APP_VERSION}.tar.gz"
                }
            }
        }

        stage("Deploy") {
            when {
                branch "main"
            }
            steps {
                echo "--- Deploying ${APP_NAME} v${APP_VERSION} ---"
                sh """
                    sudo mkdir -p ${DEPLOY_DIR}
                    sudo tar -xzf build/${APP_NAME}-${APP_VERSION}.tar.gz -C ${DEPLOY_DIR}
                    cd ${DEPLOY_DIR} && npm ci --production
                    sudo systemctl restart ${APP_NAME} || true
                """
                echo "Deployment complete!"
            }
        }
    }

    post {
        success {
            echo "Pipeline SUCCEEDED for build #${BUILD_NUMBER}"
        }
        failure {
            echo "Pipeline FAILED for build #${BUILD_NUMBER}"
        }
        always {
            cleanWs()
        }
    }
}
